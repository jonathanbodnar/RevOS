// RevOS — multi-tenant clinic + LunarPay billing platform.
// Single LunarPay merchant shared across all clinics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  // Clinical staff: scoped to their clinic AND only their assigned customers.
  // Charting + InBody + payment links + saving cards; no refunds/deletes.
  PROVIDER
  // Cross-clinic billing team: reporting, payouts, advanced costs. No clinic
  // or user management, no impersonation.
  BILLING_DEPT
  // Call center agent: works leads in /call-center for the clinics listed in
  // CallCenterAccess. No patients, billing or clinic settings.
  CALL_AGENT
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  role             Role
  clinicId         String?
  clinic           Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  isActive         Boolean  @default(true)
  // Optional TOTP MFA. Secrets stored encrypted; only enforced at login when
  // mfaEnabled is true (so a half-finished enrollment can't lock anyone out).
  // Enrollment writes mfaPendingSecret; verifying a code promotes it to the
  // live mfaSecret — so starting/abandoning re-enrollment never touches an
  // already-active factor.
  mfaSecret        String?
  mfaPendingSecret String?
  mfaEnabled       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  providerAssignments CustomerProviderAssignment[] @relation("ProviderAssignments")
  learningProgress    LearningProgress[]
  chatLogs            ChatLog[]

  // Call center: which clinics a CALL_AGENT works, and their Telnyx browser
  // phone (an on-demand telephony credential; the JWT is minted per session).
  callCenterAccess   CallCenterAccess[]
  telnyxCredentialId String?
  telnyxSipUsername  String?

  @@index([clinicId])
}

// Which customers a PROVIDER may access. Absence of a row = no access.
model CustomerProviderAssignment {
  id           String   @id @default(cuid())
  providerId   String
  provider     User     @relation("ProviderAssignments", fields: [providerId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clinicId     String?
  assignedById String?
  createdAt    DateTime @default(now())

  @@unique([providerId, customerId])
  @@index([customerId])
  @@index([providerId])
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  // Optional contact info
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Revenue-share / reporting config (per clinic, editable by super admin) ──
  // Percentage of every down payment that RevOS retains (0–100).
  revosDownPaymentSharePct Int @default(50)
  // Implementor commission paid per down payment, in cents ($140 default).
  implementorFeeCents      Int @default(14000)
  // RevOS revenue share per recurring subscription payment, in cents ($75).
  revosRecurringShareCents Int @default(7500)

  users            User[]
  customers        Customer[]
  charges          Charge[]
  subscriptions    Subscription[]
  schedules        PaymentSchedule[]
  checkoutSessions CheckoutSession[]
  auditLogs        AuditLog[]
  advancedCosts    AdvancedCost[]
  careCredits      CareCredit[]
  payouts          ClinicPayout[]
  inbodyTests      InBodyTest[]
  inbodyDevices    InBodyDevice[]
  chartWeeks       ChartWeek[]
  kpis             KPI[]
  kpiFlags         KPIFlag[]

  // Call center
  leads            Lead[]
  callRules        CallRules?
  phoneNumbers     ClinicPhoneNumber[]
  callCenterAccess CallCenterAccess[]
  leadImports      LeadImport[]
  integrations     ClinicIntegration[]
  connectLinks     ClinicConnectLink[]
}

// Sales implementors. Customers are attributed to an implementor either via
// the ?implementor=<name> tag on a payment link, or manually in the customer
// profile. Each closed down payment pays the implementor a commission.
model Implementor {
  id              String   @id @default(cuid())
  name            String
  commissionCents Int      @default(14000)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]
}

// A customer belongs to a single clinic.
// We mirror/cache LunarPay customer id so we can call the API.
model Customer {
  id       String  @id @default(cuid())
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  // LunarPay customer id (shared merchant). Nullable until first sync.
  lunarpayCustomerId Int? @unique

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?

  // Soft-inactive: hidden from default lists, still reachable by direct URL /
  // cross-clinic search, and retained for reporting history.
  isActive Boolean @default(true)

  // Date the customer signed onto the program — anchors the weekly program
  // chart (week 1 = signed week). Falls back to first paid charge when unset.
  programSignedOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sales attribution + free-form payment notes (e.g. "down payment via Care Credit").
  implementorId String?
  implementor   Implementor? @relation(fields: [implementorId], references: [id], onDelete: SetNull)
  paymentNotes  String?

  paymentMethods      PaymentMethod[]
  charges             Charge[]
  subscriptions       Subscription[]
  schedules           PaymentSchedule[]
  checkoutSessions    CheckoutSession[]
  advancedCosts       AdvancedCost[]
  careCredits         CareCredit[]
  inbodyTests         InBodyTest[]
  chartWeeks          ChartWeek[]
  providerAssignments CustomerProviderAssignment[]
  kpiFlags            KPIFlag[]
  leads               Lead[]

  @@index([clinicId])
  @@index([email])
  @@index([implementorId])
  @@index([phone])
}

// A single week of a customer's program chart — the weekly adherence grid
// providers keep (mirrors the per-week "Scheduled / Completed / Progress
// Notes" columns of the legacy tracking sheet). Weeks are numbered from the
// customer's program start (see programSignedOn / program-week helper), so
// week numbers line up with InBody "week N" scans. One row per (customer,
// week); rows are created lazily the first time a week is touched.
model ChartWeek {
  id         String   @id @default(cuid())
  clinicId   String?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  weekNumber    Int
  scheduled     Boolean @default(false)
  completed     Boolean @default(false)
  progressNotes String?

  /// Calendar start (UTC midnight) this row's week represented the last time a
  /// cell was edited, stamped from weekBounds(anchor, weekNumber). A RECORD,
  /// not a key — weekNumber stays the key. Deliberately never rewritten when
  /// the program anchor moves, so the gap between this and the freshly
  /// computed range is exactly the drift the chart surfaces to the provider.
  weekStartDate DateTime?

  // Who last touched this week (provider/clinic-admin user id) — the audit
  // trail proper lives in AuditLog; this is a cheap "last edited by".
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, weekNumber])
  @@index([clinicId])
  @@index([customerId])
}

// A Care Credit payment is money the patient paid the CLINIC directly through
// external financing (e.g. CareCredit). RevOS never touches the cash and the
// customer/Fortis is NOT charged — it is a manual log only.
//
// In reporting it is split exactly like a down payment (clinic's
// revosDownPaymentSharePct, default 50/50), with NO processing fee since no
// card was run. Because the clinic already holds the full amount, RevOS is OWED
// its share — so RevOS's care-credit share is SUBTRACTED from the balance RevOS
// owes the clinic.
model CareCredit {
  id          String   @id @default(cuid())
  clinicId    String?
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amountCents Int
  collectedOn DateTime @default(now())
  note        String?
  // "manual" (logged in the customer profile) | "master_link" (marked on a
  // master payment link at checkout).
  source      String   @default("manual")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clinicId])
  @@index([customerId])
}

// A payout RevOS has remitted to a clinic. Reduces the running balance RevOS
// owes the clinic in the reporting center.
model ClinicPayout {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  amountCents Int
  paidOn      DateTime @default(now())
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clinicId])
}

// Supplement / program-related costs advanced by RevOS on behalf of a clinic
// (e.g. 90 days of supplements per patient, printing patient booklets). These
// reduce RevOS profit in the reporting center. clinicId is required in
// practice; customerId is optional for clinic-wide costs (e.g. booklet runs).
model AdvancedCost {
  id          String    @id @default(cuid())
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  category    String // supplements | booklets | other
  description String
  amountCents Int
  incurredOn  DateTime  @default(now())
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([clinicId])
  @@index([customerId])
}

// Saved report definitions (filter config + an optional computed snapshot).
model SavedReport {
  id           String   @id @default(cuid())
  name         String
  filtersJson  String
  snapshotJson String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Cached LunarPay payment method (no raw card data ever stored)
model PaymentMethod {
  id                      String   @id @default(cuid())
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lunarpayPaymentMethodId Int      @unique
  // LunarPay customer that actually owns this vaulted card. Normally equals the
  // owning Customer's lunarpayCustomerId, but if the card is reassigned to a
  // different RevOS profile this preserves the real vault owner so charges
  // still route to the correct LunarPay customer.
  lunarpayCustomerId      Int?
  sourceType              String // "cc" | "ach"
  lastDigits              String?
  nameHolder              String?
  expMonth                String?
  expYear                 String?
  isDefault               Boolean  @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  charges       Charge[]
  subscriptions Subscription[]
  schedules     PaymentSchedule[]

  @@index([customerId])
}

model Charge {
  id              String         @id @default(cuid())
  clinicId        String?
  clinic          Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  // Originating reusable payment link (null for charges created in the admin)
  paymentLinkId String?
  paymentLink   CheckoutSession? @relation("PaymentLinkCharges", fields: [paymentLinkId], references: [id], onDelete: SetNull)

  // LunarPay charge id (they return a string id, e.g. "789")
  lunarpayChargeId    String  @unique
  fortisTransactionId String?

  amountCents       Int
  refundedCents     Int     @default(0)
  status            String // "paid" | "pending" | "refunded" | "failed"
  paymentMethodType String? // "cc" | "ach"
  description       String?

  // ── Collections follow-up ──
  // Deliberately separate from `status`: `status` is what the processor said,
  // `followUpStatus` is where the human recovery work stands. Only meaningful
  // on failed rows; everything else sits at the "new" default.
  // new | contacted | promised_to_pay | payment_plan | card_updated |
  // recovered | written_off | unreachable  ("recovered"/"written_off" close it)
  followUpStatus String    @default("new")
  followUpNote   String? // what was said, callback date, etc.
  followUpAt     DateTime? // when followUpStatus last changed
  followUpById   String? // User.id of the admin who changed it (no FK — mirrors KPIFlag.resolvedById)

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([customerId])
  @@index([paymentLinkId])
  @@index([status, followUpStatus])
}

model Subscription {
  id              String         @id @default(cuid())
  clinicId        String?
  clinic          Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  // Originating reusable payment link (null for subs created in the admin)
  paymentLinkId String?
  paymentLink   CheckoutSession? @relation("PaymentLinkSubscriptions", fields: [paymentLinkId], references: [id], onDelete: SetNull)

  lunarpaySubscriptionId Int       @unique
  amountCents            Int
  frequency              String // weekly | monthly | quarterly | yearly
  status                 String // active | cancelled
  startOn                DateTime?
  nextPaymentOn          DateTime?
  description            String?

  // ── How this subscription ended ──
  // LunarPay stops retrying and cancels on its own after enough consecutive
  // declines, which silently ends recurring revenue with nothing in the UI to
  // distinguish it from a deliberate cancellation. Recorded here rather than
  // left in AuditLog metadata so lost revenue is actually listable.
  cancelledAt         DateTime?
  cancelReason        String? // manual | auto_failed | webhook
  consecutiveFailures Int? // declines before LunarPay gave up (auto_failed)

  // Set when this subscription replaces one that died. LunarPay cannot un-cancel
  // (its cancel is a DELETE), so "restarting" always mints a new subscription —
  // this link is what lets reporting read that as recovered revenue rather than
  // as churn plus an unrelated new sale.
  restartedFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([customerId])
  @@index([paymentLinkId])
}

model PaymentSchedule {
  id              String         @id @default(cuid())
  clinicId        String?
  clinic          Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  lunarpayScheduleId Int     @unique
  status             String // active | completed | cancelled
  totalAmountCents   Int
  paidAmountCents    Int     @default(0)
  description        String?
  // Individual dated payments are stored as JSON snapshot from LunarPay
  paymentsJson       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([customerId])
}

// Public invoice / payment-link (hosted checkout session).
// For payment-link modes (payment | subscription | combined), this row is a
// REUSABLE template: status stays "open" and many customers can pay through
// the same token. For save-card mode, it remains a one-shot session that
// flips to "completed" once the customer adds their card.
// isGlobal=true links are created by super-admin and visible to all clinics.
model CheckoutSession {
  id         String    @id @default(cuid())
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  lunarpaySessionId Int     @unique
  token             String  @unique
  url               String
  amountCents       Int
  description       String?
  mode              String // payment | subscription | combined | save_card
  status            String // open | completed | expired
  metadataJson      String?
  isGlobal          Boolean @default(false)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Reusable links spawn many charges / subscriptions
  charges       Charge[]       @relation("PaymentLinkCharges")
  subscriptions Subscription[] @relation("PaymentLinkSubscriptions")

  @@index([clinicId])
  @@index([isGlobal])
}

// Audit log: super-admin actions, impersonation, etc.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // user who did the action
  actorRole  String?
  clinicId   String?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  action     String // e.g. "clinic.create", "impersonate.start", "charge.create"
  targetType String? // e.g. "Clinic", "Customer", "Charge"
  targetId   String?
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([actorId])
  @@index([action])
}

// A single InBody body-composition test, delivered via the LookinBody Web
// webhook (a notification containing identifiers + phone) and enriched with
// the full result set fetched from the InBody Web API (searched by phone /
// UserToken). Tests auto-pair to a RevOS Customer by phone number; unmatched
// tests can be mapped manually by a super admin.
model InBodyTest {
  id String @id @default(cuid())

  // ── RevOS linkage (auto-paired by phone or mapped manually) ──
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ── Identifiers from the webhook notification ──
  // Stable dedupe key: account:equipSerial:inbodyUserId:testDatetimes
  dedupeKey       String    @unique
  account         String? // LookinBody Web account (e.g. "revosinbody2")
  equipSerial     String? // EquipSerial
  equip           String? // Equip (e.g. "InBody770")
  deviceType      String? // Type (e.g. "InBody")
  inbodyUserId    String? // UserID (location-local id)
  phone           String? // TelHP (raw, as delivered)
  phoneNormalized String? // last-10-digits, for matching
  testedAt        DateTime? // parsed from TestDatetimes (yyyyMMddHHmmss)
  isTempData      Boolean   @default(false)

  // ── Minimum required InBody outputs (nullable until result fetched) ──
  weightKg             Float?
  totalBodyWaterKg     Float?
  dryLeanMassKg        Float?
  skeletalMuscleMassKg Float?
  bodyFatMassKg        Float?
  bmi                  Float?
  percentBodyFat       Float?

  // Segmental Lean Analysis — 10 outputs (5 segments × lean mass + percent).
  segLeanRightArmKg  Float?
  segLeanLeftArmKg   Float?
  segLeanTrunkKg     Float?
  segLeanRightLegKg  Float?
  segLeanLeftLegKg   Float?
  segLeanRightArmPct Float?
  segLeanLeftArmPct  Float?
  segLeanTrunkPct    Float?
  segLeanRightLegPct Float?
  segLeanLeftLegPct  Float?

  // pending | fetched | matched_no_data | unmatched | error
  resultStatus String  @default("pending")
  matchStatus  String  @default("unmatched") // unmatched | auto | manual | ambiguous
  fetchError   String?
  rawJson      String? // full fetched result payload
  webhookJson  String? // original webhook notification payload

  // ── Triage (super-admin) ──
  // A test that will never be mapped: a walk-in who isn't a patient, a device
  // self-test, a demo seed. Soft flag, never a delete — the row is PHI-bearing
  // evidence that a real scan happened, and a delete wouldn't stick anyway:
  // ingest upserts on dedupeKey, so the next webhook re-delivery or
  // "Pull today's data" sync would recreate it via the create branch.
  dismissedAt     DateTime?
  dismissedById   String? // User.id of the super admin who dismissed it
  dismissedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([customerId])
  @@index([phoneNormalized])
  @@index([testedAt])
  @@index([resultStatus])
  @@index([dismissedAt])
  @@index([customerId, dismissedAt])
}

// ── KPI engine (Phase 4) ────────────────────────────────────────────────────
// Super-admin-defined KPI. clinicId null = global (applies to every clinic);
// set = clinic-specific. A nightly job evaluates each active KPI per customer
// and raises KPIFlags.
model KPI {
  id          String  @id @default(cuid())
  name        String
  description String?
  // What to measure. Extensible string enum so new metrics don't need a
  // migration: e.g. "body_fat_pct_change", "weight_change_kg",
  // "visit_adherence_pct", "no_scan_weeks", "days_since_last_charge".
  metric      String
  // Comparison + threshold: flag when metric <comparison> threshold.
  // comparison ∈ gt | gte | lt | lte
  comparison  String
  threshold   Float
  // Rolling window (days) the metric is computed over. 0 = whole program.
  windowDays  Int     @default(0)
  severity    String  @default("warn") // info | warn | critical
  isActive    Boolean @default(true)

  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flags KPIFlag[]

  @@index([clinicId])
  @@index([isActive])
}

model KPIFlag {
  id         String   @id @default(cuid())
  kpiId      String
  kpi        KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  clinicId   String?
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Value that tripped the threshold + a human-readable detail.
  value    Float?
  detail   String?
  severity String  @default("warn")
  status   String  @default("open") // open | resolved | dismissed

  // Idempotency: one open flag per (kpi, customer, evalKey) where evalKey is a
  // window stamp the evaluator computes, so re-runs don't duplicate.
  evalKey String

  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([kpiId, customerId, evalKey])
  @@index([clinicId])
  @@index([customerId])
  @@index([status])
}

// ── eLearning (Phase 5) ─────────────────────────────────────────────────────
model LearningModule {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?
  // Rich-text body stored as HTML (sanitized on write).
  bodyHtml    String?
  videoUrl    String?
  // Ordering + grouping.
  category    String?
  position    Int       @default(0)
  // Who may see it: CLINIC_ADMIN | PROVIDER | BOTH
  audience    String    @default("BOTH")
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  progress LearningProgress[]

  @@index([category])
  @@index([publishedAt])
}

model LearningProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      String         @default("in_progress") // in_progress | completed
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, moduleId])
  @@index([moduleId])
}

// ── Internal chat assistant (Phase 6) ───────────────────────────────────────
// Every assistant interaction is logged (compliance requirement). The
// question/answer are ENCRYPTED at rest. The retrieved training context sent
// to any model backend is non-PHI; the user's free-typed question is not
// scrubbed, so the model backend must be BAA-covered before it's enabled.
model ChatLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String?
  question  String
  answer    String?
  // "elearning" (RAG over modules) | "data" (customer-aware tool use)
  mode      String   @default("elearning")
  // Non-PHI metadata: tools invoked, token counts, whether PHI was accessed.
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clinicId])
  @@index([createdAt])
}

/// One row per restart attempt, claimed before any billing call.
/// The unique constraint — not the check-then-act reads in the route — is what
/// actually prevents two concurrent restarts from creating two live
/// subscriptions for the same patient. Claiming costs nothing to lose.
model SubscriptionRestartClaim {
  id              String   @id @default(cuid())
  restartedFromId String   @unique
  createdAt       DateTime @default(now())
}

/// A physical InBody unit, keyed by the serial the device stamps on every scan.
/// One unit lives at one clinic, which is what lets an UNPAIRED scan still say
/// where it came from — without this, a walk-in who never became a patient is
/// just an orphan row with no location. Rows are created automatically the
/// first time a serial appears; a super admin assigns the clinic.
model InBodyDevice {
  id         String    @id @default(cuid())
  serial     String    @unique
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  label      String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clinicId])
}

// ============================================================================
// Call center (RevOS 2.0). Leads are people a clinic wants called before they
// are patients. The call center works them from /call-center, one clinic at a
// time, with the Dial Desk's rules (see src/lib/call-center/). Calls go through
// Telnyx: the agent's browser phone stays on one parked line and RevOS dials
// each lead and bridges them in (src/lib/call-center/dialer.ts).
// ============================================================================

/// A person to call for one clinic. One row per (clinic, phone).
model Lead {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  /// 10 digits (US). The dedupe key and the number we dial.
  phone     String
  email     String?

  /// new | cycle | nurture | booked | resched | handed | showed | lost | dnq | dnc
  /// (the Dial Desk stages; labels live in src/lib/call-center/stages.ts).
  stage      String  @default("new")
  priority   Boolean @default(false)
  lostReason String?

  /// No-answer tries in the current cycle. Talking to them resets it.
  attempts        Int       @default(0)
  dials           Int       @default(0)
  lastCalledAt    DateTime?
  /// Clinic-local calendar days (YYYY-MM-DD), exactly like the Dial Desk.
  lastAttemptDay  String?
  nextDueDay      String?
  callbackAt      DateTime?
  apptAt          DateTime?
  /// Confirmation calls done for the current appointment (clinic-local days).
  confirm48Day    String?
  confirm24Day    String?
  confirmDayOfDay String?
  confirmedAt     DateTime?
  /// Not reached on the appointment day: the clinic front desk should text.
  needsTextDay    String?
  /// "Skip for now": sorts the lead to the end of that day's list.
  skippedAt       DateTime?

  /// Latest note, encrypted (free-text PHI).
  lastNote String?

  /// Prior express written consent to be called with a dialer (Florida and
  /// Oklahoma require it for automated dialing). Auto-dial only calls leads
  /// with this set unless the clinic's rules say otherwise.
  consentAt     DateTime?
  consentSource String?

  /// csv | xlsx | zenoti | mindbody | aesthetic_record | manual | inbound
  source       String?
  externalId   String?
  /// The clinic's own status text at import time (sheet or CRM).
  sourceStatus String?
  importId     String?
  import       LeadImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  /// Set once the lead is (or becomes) a patient in this clinic.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Soft claim so two agents, or the auto dialer, never call the same person
  /// at once. Expires on its own.
  claimedById  String?
  claimedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  calls      LeadCall[]

  @@unique([clinicId, phone])
  @@index([clinicId, stage])
  @@index([clinicId, nextDueDay])
  @@index([customerId])
}

/// Every logged call result or status change on a lead (the Dial Desk history).
model LeadActivity {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinicId    String
  userId      String?
  at          DateTime  @default(now())
  /// Clinic-local day of `at` (YYYY-MM-DD): keys the day's list and the report.
  day         String
  /// callback | confirm | resched | cycle | fresh | manual | inbound | mark | import
  kind        String
  /// na | vm | book | cb | ni | dnq | dnc | conf | cna | resch | cancel | note |
  /// showed | cancelled | noshow | recycle | stage | missed | imported
  outcome     String
  /// d2 | d1 | d0 on confirmation calls (48-hour, 24-hour, morning-of).
  touch       String?
  /// Callback or appointment time this entry set.
  scheduledAt DateTime?
  /// Encrypted.
  note        String?
  callId      String?

  @@index([leadId, at])
  @@index([clinicId, day])
}

/// One phone call placed or received through Telnyx.
model LeadCall {
  id                  String    @id @default(cuid())
  clinicId            String
  leadId              String?
  lead                Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId              String?
  sessionId           String?
  /// outbound | inbound
  direction           String    @default("outbound")
  /// manual | auto
  mode                String    @default("manual")
  /// 1, or 2 for the immediate second dial of a double-dial.
  dialNumber          Int       @default(1)
  /// The list section the call was placed from (fresh, cycle, callback, …)
  /// and the confirmation touch, so an auto-dialed no-answer is logged right.
  kind                String?
  touch               String?
  /// queued | dialing | answered | bridged | ended | failed
  status              String    @default("queued")
  fromNumber          String?
  toNumber            String
  telnyxCallControlId String?   @unique
  telnyxCallLegId     String?
  telnyxCallSessionId String?
  /// human | machine | not_sure | silence | fax_detected (answering machine detection)
  amdResult           String?
  hangupCause         String?
  /// Result logged for this call (na, vm, book, …).
  outcome             String?
  error               String?
  startedAt           DateTime  @default(now())
  answeredAt          DateTime?
  bridgedAt           DateTime?
  endedAt             DateTime?

  @@index([clinicId, startedAt])
  @@index([leadId, startedAt])
  @@index([sessionId])
}

/// An agent's live phone line on the desk. One open session per agent.
model DialerSession {
  id                 String    @id @default(cuid())
  clinicId           String
  userId             String
  /// manual | auto
  mode               String    @default("manual")
  /// connecting | ready | dialing | connected | wrapup | paused | ended
  status             String    @default("connecting")
  /// The agent's parked browser leg. Leads are bridged onto it.
  agentCallControlId String?   @unique
  currentCallId      String?
  currentLeadId      String?
  lastError          String?
  startedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  endedAt            DateTime?

  @@index([userId, status])
  @@index([clinicId, status])
}

/// Per-clinic calling rules, edited on the call center's Rules page.
/// Defaults match the Dial Desk prototype.
model CallRules {
  clinicId            String   @id
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  timezone            String   @default("America/Chicago")
  dailyTarget         Int      @default(200)
  maxAttempts         Int      @default(4)
  /// Work days between no-answer tries.
  spacingDays         Int      @default(2)
  /// 0 = Sunday … 6 = Saturday. Sunday is never a calling day.
  workDays            Int[]    @default([1, 2, 3, 4, 5])
  freshDays           Int[]    @default([2, 3, 4, 5])
  /// New leads kept on the list each fresh day even when follow-ups pile up.
  freshFloor          Int      @default(40)
  /// Minutes after midnight, clinic time.
  callStartMinute     Int      @default(540)
  callEndMinute       Int      @default(1140)
  /// Florida and Oklahoma cap sales calls at 3 per person per 24 hours.
  maxCallsPer24h      Int      @default(3)
  doubleDial          Boolean  @default(true)
  rebookAttempts      Int      @default(3)
  /// Days before "unable to contact" leads go back to new (0 = never).
  recycleDays         Int      @default(0)
  confirm48h          Boolean  @default(true)
  confirm24h          Boolean  @default(true)
  confirmDayOf        Boolean  @default(true)
  ringSeconds         Int      @default(25)
  /// Auto-dial: hang up on answering machines instead of connecting them.
  skipVoicemail       Boolean  @default(false)
  /// Auto-dial only leads with written consent on file.
  autoDialConsentOnly Boolean  @default(true)
  updatedById         String?
  updatedAt           DateTime @updatedAt
}

/// Extra new leads pulled onto one clinic's list for one day ("Add 25 new leads").
model CallDay {
  clinicId   String
  day        String
  extraFresh Int    @default(0)

  @@id([clinicId, day])
}

/// A Telnyx number that calls go out from (and patients call back) for a clinic.
model ClinicPhoneNumber {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// +1XXXXXXXXXX
  e164           String   @unique
  telnyxNumberId String?
  label          String?
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([clinicId])
}

/// Which clinics a CALL_AGENT may work. Super admins see every clinic.
model CallCenterAccess {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, clinicId])
  @@index([clinicId])
}

/// The Telnyx objects RevOS created for itself (one row, id "default").
/// The API key and webhook public key stay in env vars.
model CallCenterSettings {
  id                           String   @id @default("default")
  telnyxOutboundVoiceProfileId String?
  telnyxCallControlAppId       String?
  telnyxCredentialConnectionId String?
  webhookUrl                   String?
  updatedAt                    DateTime @updatedAt
}

/// One import of leads into a clinic (a file upload or a CRM pull).
model LeadImport {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// csv | xlsx | zenoti | mindbody | aesthetic_record
  source      String
  fileName    String?
  /// staff | clinic_link
  via         String    @default("staff")
  createdById String?
  linkId      String?
  rowsTotal   Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  invalid     Int       @default(0)
  /// Column and status mapping used (no row data).
  mapping     Json?
  /// running | done | failed
  status      String    @default("running")
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  leads Lead[]

  @@index([clinicId, createdAt])
}

/// A clinic's connection to its own CRM (Zenoti, Mindbody, Aesthetic Record).
model ClinicIntegration {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// zenoti | mindbody | aesthetic_record
  provider     String
  /// pending | connected | error | disconnected
  status       String    @default("pending")
  /// Encrypted JSON: API keys, site ids, tokens. Never sent to the browser.
  credentials  String?
  /// Non-secret identity shown in the UI (center name, site id).
  accountLabel String?
  externalId   String?
  /// staff | clinic_link
  connectedVia String?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([clinicId, provider])
}

/// The one-page link a clinic gets to connect its CRM and upload lead files.
model ClinicConnectLink {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// sha256 of the token, used for lookup.
  tokenHash   String    @unique
  /// The token itself, encrypted, so staff can copy the link again.
  tokenEnc    String
  createdById String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([clinicId])
}
